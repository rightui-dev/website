// HOME_IMPORT
routes nav
// GENERATED_ROUTES
component RightUI
  resource viewport = exactViewport() as shape Viewport
  resource catalog = loadCatalog() as shape CatalogEntry[] else empty()
  resource aiCatalog = loadAI() as shape CatalogEntry[] else empty()
  resource charts = loadCharts() when top(nav).name == "area" as shape ChartEntry[] else empty()
  resource blocks = loadBlocks() when top(nav).name.startsWith("blocks") as shape BlockEntry[] else empty()
  resource page = loadPage(top(nav).name) as shape Page else empty()
  resource source = loadSource(top(nav).name == "source" ? searchParam(top(nav), "file") : page.source) when top(nav).name == "source" or top(nav).name.startsWith("component_") as shape SourceFile else empty()
  resource compatibility = loadCompatibility() when top(nav).name == "compatibility" as shape CompatibilityReport else empty()
  resource themeExport = loadTheme(preset, density, radius, fontChoice) when top(nav).name == "themes" as shape ThemeExport else empty()
  state theme = "system" persist
  state uiPreset = "neutral" persist
  state uiDensity = "comfortable" persist
  state uiRadius = "default" persist
  state uiFont = "sans" persist
  state menu = false
  state themeReady = false
  state themeOpen = false
  state themeEpoch = 0
  state searchOpen = false
  state homeDialog = false
  state query = ""
  state activeHit = 0
  state showCode = false
  state copiedId = ""
  state copiedText = ""
  state copyVersion = 0
  state demoTime = 0
  state demoUntil = 0
  provide
    uiFont = fontChoice
    uiCopiedId = copiedId
    uiCopiedText = copiedText
    uiCopyCode = copyCode
    rightuiDemoTime = demoTime
    rightuiRunDemo = runDemo
  action copyCode(id: string, text: string)
    copyText(text)
    copiedId = id
    copiedText = text
    copyVersion = copyVersion + 1
  action clearCopyFeedback
    copiedId = ""
    copiedText = ""
  task clearCopy when copiedId != "" key=copyVersion
    after(3000, clearCopyFeedback)
  action runDemo(duration: number)
    demoUntil = max(demoUntil, demoTime + duration)
  action tickDemo
    demoTime = min(demoUntil, demoTime + 32)
  task demoClock when demoTime < demoUntil and (top(nav).name.startsWith("ai_") or top(nav).name == "component_trace")
    every(32, tickDemo)
  state headerHeight = 64
  state titlebarHeight = 32
  state forwardLocations: string[] = []
  action measureTitlebar(w: number, h: number)
    titlebarHeight = h
  action measureHeader(w: number, h: number)
    headerHeight = h
  // CSS viewport lengths draw the shell before activation; measured width gates focus and demos.
  derive nativeApp = {{NATIVE_APP}}
  derive nativeMac = {{NATIVE_MAC}}
  derive chromeHeight = nativeMac ? titlebarHeight : 0
  derive canGoBack = stack(nav).length > 1 or page.kind == "view"
  derive canGoForward = forwardLocations.length > 0
  derive mobile = viewport.width < 1024
  derive doc = ["how_exact", "installation", "typescript", "rust", "theming", "registry", "components", "compatibility"].includes(top(nav).name) or top(nav).name.startsWith("component_") or top(nav).name.startsWith("ai_")
  derive searchEntries = [CatalogEntry(slug="how_exact", title="How Exact works", description="Understand Contract, RightUI, TypeScript and Rust", href="/docs/how-exact-works"), CatalogEntry(slug="compatibility", title="Compatibility", description="Platform validation for every component", href="/docs/compatibility"), CatalogEntry(slug="installation", title="Installation", description="Set up rightui", href="/docs/installation"), CatalogEntry(slug="typescript", title="TypeScript", description="TypeScript data integration", href="/docs/installation/typescript"), CatalogEntry(slug="rust", title="Rust", description="Rust data integration", href="/docs/installation/rust"), CatalogEntry(slug="theming", title="Theming", description="Theme tokens and dark mode", href="/docs/theming"), CatalogEntry(slug="blocks", title="Blocks", description="Ready-to-use layouts", href="/blocks"), CatalogEntry(slug="area", title="Area Charts", description="Charts and graphs", href="/charts/area")].concat(catalog).concat(aiCatalog)
  derive matches = searchEntries.filter(c => (c.title + " " + c.description).toLowerCase().includes(query.toLowerCase())).slice(0, 10)
  derive themeQuery = searchParam(top(nav), "theme")
  derive scheme = ["dark", "light", "system"].includes(themeQuery) ? themeQuery : (theme == "dark" or theme == "light" ? theme : "system")
  derive effectiveTheme = scheme == "system" ? (viewport.prefersColorScheme == "dark" ? "dark" : "light") : scheme
  derive presetQuery = searchParam(top(nav), "preset")
  derive densityQuery = searchParam(top(nav), "density")
  derive radiusQuery = searchParam(top(nav), "radius")
  derive fontQuery = searchParam(top(nav), "font")
  derive preset = {{THEME_PRESETS}}.includes(presetQuery) ? presetQuery : ({{THEME_PRESETS}}.includes(uiPreset) ? uiPreset : "neutral")
  derive density = ["comfortable", "compact"].includes(densityQuery) ? densityQuery : (uiDensity == "compact" ? "compact" : "comfortable")
  derive radius = ["default", "sharp", "round"].includes(radiusQuery) ? radiusQuery : (["default", "sharp", "round"].includes(uiRadius) ? uiRadius : "default")
  derive fontChoice = {{THEME_FONTS}}.includes(fontQuery) ? fontQuery : ({{THEME_FONTS}}.includes(uiFont) ? uiFont : "sans")
  derive themeSearch = `theme=${effectiveTheme}&preset=${preset}&density=${density}&radius=${radius}&font=${fontChoice}`
  task theming key=`${scheme}/${preset}/${density}/${radius}/${fontChoice}`
    change(applyTheme)
  action applyTheme
    setScheme(scheme)
    setMode("ui-preset", preset)
    setMode("ui-density", density)
    setMode("ui-radius", radius)
    themeReady = true
  action chooseTheme(p: string, d: string, r: string, f: string)
    uiPreset = p
    uiDensity = d
    uiRadius = r
    uiFont = f
    let url = top(nav).url
    let hash = fragment(top(nav))
    let queryAt = url.indexOf("?")
    let path = queryAt < 0 ? url : url.slice(0, queryAt)
    let remaining = queryAt < 0 ? "" : url.slice(queryAt + 1).split("&").filter(part => not ["preset", "density", "radius", "font"].includes((match part.split("=").at(0) { case some(k) => k, case none => "" }))).join("&")
    nav = replace(nav, path + `?preset=${p}&density=${d}&radius=${r}&font=${f}` + (remaining == "" ? "" : "&" + remaining) + (hash == "" ? "" : "#" + hash))
    setMode("ui-preset", p)
    setMode("ui-density", d)
    setMode("ui-radius", r)
  action chooseScheme(next: string)
    theme = next
    if ["dark", "light", "system"].includes(themeQuery)
      let url = top(nav).url
      let hash = fragment(top(nav))
      let queryAt = url.indexOf("?")
      let remainingQuery = url.slice(queryAt + 1).split("&").filter(part => part != "theme" and not part.startsWith("theme=")).join("&")
      nav = replace(nav, url.slice(0, queryAt) + "?theme=" + next + (remainingQuery == "" ? "" : "&" + remainingQuery) + (hash == "" ? "" : "#" + hash))
    setScheme(next)
  action chooseQuickPreset(value: string)
    chooseTheme(value, density, radius, fontChoice)
  action chooseQuickFont(value: string)
    chooseTheme(preset, density, radius, value)
  action chooseQuickRadius(value: string)
    chooseTheme(preset, density, value, fontChoice)
  action toggleThemeMenu
    if themeOpen
      themeOpen = false
    else
      menu = false
      searchOpen = false
      homeDialog = false
      themeEpoch = themeEpoch + 1
      themeOpen = true
      showPopover("theme-settings", source="theme-toggle")
      focus("quick-scheme-" + ["light", "dark", "system"].indexOf(scheme).toString())
  action closeThemeMenu(epoch: number)
    if epoch == themeEpoch
      themeOpen = false
  action follow(url: string)
    themeOpen = false
    query = ""
    activeHit = 0
    menu = false
    showCode = false
    searchOpen = false
    homeDialog = false
    if url.startsWith("/") and not url.startsWith("//")
      let target = go(nav, url)
      let entry = top(target)
      let next = entry.url
      let extra = nativeMac and stack(target).length < stack(nav).length ? "" : (searchParam(entry, "theme") == "" ? "&theme=" + scheme : "") + (searchParam(entry, "preset") == "" ? "&preset=" + preset : "") + (searchParam(entry, "density") == "" ? "&density=" + density : "") + (searchParam(entry, "radius") == "" ? "&radius=" + radius : "") + (searchParam(entry, "font") == "" ? "&font=" + fontChoice : "")
      let hash = fragment(entry)
      let location = next + (next.includes("?") ? extra : (extra == "" ? "" : "?" + extra.slice(1))) + (hash == "" ? "" : "#" + hash)
      if nativeMac
        let destination = go(nav, location)
        if stack(destination).length < stack(nav).length
          forwardLocations = stack(nav).slice(stack(destination).length).map(e => e.url + (fragment(e) == "" ? "" : "#" + fragment(e))).concat(forwardLocations)
        else if location != top(nav).url + (fragment(top(nav)) == "" ? "" : "#" + fragment(top(nav)))
          forwardLocations = (match forwardLocations.at(0) { case some(ahead) => ahead == location, case none => false }) ? forwardLocations.slice(1) : []
      nav = go(nav, location)
    else
      nav = go(nav, url)
  action toggleMenu
    themeOpen = false
    menu = not menu
  action openHomeDialog
    themeOpen = false
    searchOpen = false
    homeDialog = true
    focus("home-confirmation-cancel")
  action closeHomeDialog
    homeDialog = false
    focus("home-dialog")
  action openSearch
    themeOpen = false
    homeDialog = false
    searchOpen = true
    focus("search-input")
  action closeSearch
    searchOpen = false
    focus("search-open")
  action search(v: string)
    query = v
    activeHit = 0
  action searchKey(k: string)
    if k == "ArrowDown"
      preventDefault()
      activeHit = min(activeHit + 1, max(0, matches.length - 1))
    if k == "ArrowUp"
      preventDefault()
      activeHit = max(0, activeHit - 1)
    if k == "Enter"
      match matches.at(activeHit)
        case some(hit)
          follow(hit.href)
        case none
          activeHit = 0
  action keys(k: string, e: KeyboardEvent)
    if nativeMac and e.metaKey and k == "["
      preventDefault()
      navigateBack()
    if nativeMac and e.metaKey and k == "]"
      preventDefault()
      navigateForward()
    if (e.metaKey or e.ctrlKey) and k.toLowerCase() == "k"
      preventDefault()
      openSearch()
  action returnToBlocks
    if stack(nav).length > 1
      nav = back(nav)
    else
      nav = replace(nav, "/blocks?" + themeSearch)
  action navigateBack
    if stack(nav).length > 1
      forwardLocations = [top(nav).url + (fragment(top(nav)) == "" ? "" : "#" + fragment(top(nav)))].concat(forwardLocations)
      themeOpen = false
      menu = false
      searchOpen = false
      homeDialog = false
      showCode = false
      nav = back(nav)
    else if page.kind == "view"
      follow("/blocks")
  action navigateForward
    match forwardLocations.at(0)
      case some(location)
        follow(location)
      case none
        forwardLocations = []
  action openWebsite
    openURL("https://rightui.dev" + top(nav).url + (fragment(top(nav)) == "" ? "" : "#" + fragment(top(nav))))
  action toggleCode
    showCode = not showCode
  view
