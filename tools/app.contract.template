          if nativeApp and not nativeMac and page.kind == "view"
            row padding="ui.space-8 ui.space-16" background-color="ui.background" align-items="center" flex-shrink=0
              button id="back" testId="block-back" class=Hit press=returnToBlocks display="flex" align-items="center" gap="ui.space-8" padding="ui.space-8"
                svg width=16 height=16 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
