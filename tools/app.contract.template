// HOME_IMPORT
fn navigationId(name: string, scope: string, active: bool): string = active ? name : name + "-route-" + scope
fn isDocumentation(name: string): bool = ["how_exact", "installation", "typescript", "rust", "theming", "registry", "components", "compatibility"].includes(name) or name.startsWith("component_") or name.startsWith("ai_")
fn appearanceExtras(url: string): string = url.includes("?") ? url.slice(url.indexOf("?") + 1).split("&").filter(part => not ["theme", "preset", "density", "radius", "font"].includes((match part.split("=").at(0) { case some(k) => k, case none => "" }))).join("&") : ""
fn appearanceLocation(url: string, hash: string, s: string, p: string, d: string, r: string, f: string): string = (url.includes("?") ? url.slice(0, url.indexOf("?")) : url) + `?theme=${s}&preset=${p}&density=${d}&radius=${r}&font=${f}` + (appearanceExtras(url) == "" ? "" : "&" + appearanceExtras(url)) + (hash == "" ? "" : "#" + hash)
