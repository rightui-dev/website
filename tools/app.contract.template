              svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                path d="m12 5 7 7-7 7m7-7H5"
          view flex=1
          button testId="mac-website" class=Hit press=openWebsite aria-label="Open this page on rightui.dev" title="Open in browser" width="ui.space-28" height="ui.space-28" padding="ui.space-0" display="flex" align-items="center" justify-content="center"
