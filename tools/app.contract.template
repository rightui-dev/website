        row id="mac-titlebar" testId="mac-titlebar" resize=measureTitlebar position="absolute" top=0 left=0 right=0 height="max(32px, env(titlebar-area-height, 0px))" padding-left="env(titlebar-area-x, 0px)" padding-right="ui.space-8" box-sizing="border-box" align-items="center" z-index=60
