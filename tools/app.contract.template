            button id="back" testId="mac-back" class=Hit press=navigateBack disabled=(not canGoBack) aria-label="Go back" title="Go back" width="ui.space-28" height="ui.space-28" padding="ui.space-0" display="flex" align-items="center" justify-content="center"
              svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                path d="m12 5-7 7 7 7m-7-7h14"
