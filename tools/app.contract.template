                  row testId="made-with-exact" padding="ui.space-0 ui.space-24 calc(ui.space-64 + clamp(0px, (100vw - 767px) * 1000, ui.space-32))" gap="ui.space-4" justify-content="center" flex-wrap="wrap" color="ui.muted-foreground" font-size="ui.text-caption"
