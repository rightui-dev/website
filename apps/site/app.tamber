// RightUI theme. Bundle AlloVariable.ttf (Allo 1.0.1, SIL OFL) alongside the package fonts and licenses.
// Light/dark/system is controlled separately by setScheme().
// In App, provide uiFont = "theme" to use this configuration's body family. Also import defaultFontWeights and provide uiWeights = defaultFontWeights().
tamber app

axes
  ui-preset = neutral | indigo | forest | rose | amber | violet
  ui-density = comfortable | compact
  ui-radius = default | sharp | round

theme
  AccentColor = light-dark(#000000, #e5e5e5)
  ui.palette-background: color = light-dark(#ffffff, #0a0a0a)
    when ui-preset=indigo: light-dark(#f8fafc, #090e1a)
    when ui-preset=forest: light-dark(#f6f7f0, #10170f)
    when ui-preset=rose: light-dark(#fff8fa, #190b10)
    when ui-preset=amber: light-dark(#fffbf2, #1b1208)
    when ui-preset=violet: light-dark(#faf5ff, #160b24)
  ui.background: color = ui.palette-background
  ui.palette-foreground: color = light-dark(#000000, #fafafa)
    when ui-preset=indigo: light-dark(#111827, #eef2ff)
    when ui-preset=forest: light-dark(#1d2b18, #edf4e7)
    when ui-preset=rose: light-dark(#381320, #ffe4ec)
    when ui-preset=amber: light-dark(#3b260b, #fff1d6)
    when ui-preset=violet: light-dark(#2e1065, #faf5ff)
  ui.foreground: color = ui.palette-foreground
  ui.palette-surface: color = light-dark(#ffffff, #171717)
    when ui-preset=indigo: light-dark(#ffffff, #131c30)
    when ui-preset=forest: light-dark(#fdfef8, #1a2518)
    when ui-preset=rose: light-dark(#fffdfd, #29131c)
    when ui-preset=amber: light-dark(#fffef9, #2b1d0e)
    when ui-preset=violet: light-dark(#fefaff, #21112f)
  ui.surface: color = ui.palette-surface
  ui.palette-muted: color = light-dark(#f5f5f5, #262626)
    when ui-preset=indigo: light-dark(#e8eefc, #1e2a43)
    when ui-preset=forest: light-dark(#e7ecd9, #293625)
    when ui-preset=rose: light-dark(#fce7ef, #3c1c2b)
    when ui-preset=amber: light-dark(#f9ecd0, #3c2a13)
    when ui-preset=violet: light-dark(#f3e8ff, #301647)
  ui.muted: color = ui.palette-muted
  ui.palette-muted-foreground: color = light-dark(#737373, #a3a3a3)
    when ui-preset=indigo: light-dark(#52627b, #a5b4d2)
    when ui-preset=forest: light-dark(#5b6850, #afbea2)
    when ui-preset=rose: light-dark(#875064, #d9a5b7)
    when ui-preset=amber: light-dark(#79603a, #d4ba8e)
    when ui-preset=violet: light-dark(#6b21a8, #d8b4fe)
  ui.muted-foreground: color = ui.palette-muted-foreground
  ui.palette-border: color = light-dark(#e5e5e5, #ffffff1a)
    when ui-preset=indigo: light-dark(#cbd5e8, #33415f)
    when ui-preset=forest: light-dark(#c8d1b8, #405039)
    when ui-preset=rose: light-dark(#e9bfce, #683448)
    when ui-preset=amber: light-dark(#e7cda0, #6b4c26)
    when ui-preset=violet: light-dark(#d8b4fe, #583570)
  ui.border: color = ui.palette-border
  ui.palette-primary: color = light-dark(#000000, #e5e5e5)
    when ui-preset=indigo: light-dark(#4338ca, #a5b4fc)
    when ui-preset=forest: light-dark(#3f6212, #bef264)
    when ui-preset=rose: light-dark(#be123c, #fda4af)
    when ui-preset=amber: light-dark(#92400e, #fcd34d)
    when ui-preset=violet: light-dark(#7e22ce, #c084fc)
  ui.primary: color = ui.palette-primary
  ui.palette-primary-foreground: color = light-dark(#fafafa, #171717)
    when ui-preset=indigo: light-dark(#ffffff, #14183c)
    when ui-preset=forest: light-dark(#ffffff, #20300c)
    when ui-preset=rose: light-dark(#ffffff, #4c0519)
    when ui-preset=amber: light-dark(#ffffff, #451a03)
    when ui-preset=violet: light-dark(#ffffff, #21112f)
  ui.primary-foreground: color = ui.palette-primary-foreground
  ui.palette-danger: color = light-dark(#e7000b, #ff6467)
  ui.danger: color = ui.palette-danger
  ui.palette-success: color = light-dark(#15803d, #4ade80)
  ui.success: color = ui.palette-success
  ui.palette-overlay: color = #00000080 scheme=fixed
  ui.overlay: color = ui.palette-overlay
  ui.palette-ring: color = light-dark(#a3a3a380, #73737380)
    when ui-preset=indigo: light-dark(#6366f180, #a5b4fc80)
    when ui-preset=forest: light-dark(#65a30d80, #bef26480)
    when ui-preset=rose: light-dark(#e11d4880, #fda4af80)
    when ui-preset=amber: light-dark(#d9770680, #fcd34d80)
    when ui-preset=violet: light-dark(#9333ea80, #c084fc80)
  ui.ring: color = ui.palette-ring
  ui.palette-focus: color = light-dark(#a3a3a3, #737373)
    when ui-preset=indigo: light-dark(#4f46e5, #a5b4fc)
    when ui-preset=forest: light-dark(#4d7c0f, #bef264)
    when ui-preset=rose: light-dark(#be123c, #fda4af)
    when ui-preset=amber: light-dark(#b45309, #fcd34d)
    when ui-preset=violet: light-dark(#7e22ce, #c084fc)
  ui.focus: color = ui.palette-focus
  ui.palette-wheel-cursor: color = #ffffff scheme=fixed
  ui.wheel-cursor: color = ui.palette-wheel-cursor
  ui.palette-wheel-outline: color = #000000 scheme=fixed
  ui.wheel-outline: color = ui.palette-wheel-outline
  ui.palette-sidebar: color = light-dark(#fafafa, #171717)
    when ui-preset=indigo: light-dark(#eef2ff, #10182a)
    when ui-preset=forest: light-dark(#eef1e4, #162013)
    when ui-preset=rose: light-dark(#fff0f5, #221017)
    when ui-preset=amber: light-dark(#fff5e0, #24190c)
    when ui-preset=violet: light-dark(#f3e8ff, #1c0f2b)
  ui.sidebar: color = ui.palette-sidebar
  ui.palette-input: color = light-dark(#e5e5e5, #ffffff26)
    when ui-preset=indigo: light-dark(#b8c5e0, #3b4a6a)
    when ui-preset=forest: light-dark(#bdc9ab, #4a5a42)
    when ui-preset=rose: light-dark(#d9a4b7, #794059)
    when ui-preset=amber: light-dark(#d7b47c, #7d5a2e)
    when ui-preset=violet: light-dark(#c99bec, #6b3f85)
  ui.input: color = ui.palette-input
  ui.palette-shadow: color = light-dark(#0000000d, #00000026)
  ui.shadow: color = ui.palette-shadow
  ui.palette-metric-shade: color = light-dark(#f0f0f0, #171717)
    when ui-preset=indigo: light-dark(#e8eefc, #131c30)
    when ui-preset=forest: light-dark(#e7ecd9, #1a2518)
    when ui-preset=rose: light-dark(#fce7ef, #29131c)
    when ui-preset=amber: light-dark(#f9ecd0, #2b1d0e)
    when ui-preset=violet: light-dark(#f3e8ff, #21112f)
  ui.metric-shade: color = ui.palette-metric-shade
  ui.palette-on-danger: color = #ffffff scheme=fixed
  ui.on-danger: color = ui.palette-on-danger
  ui.palette-destructive: color = light-dark(#e7000b, #ff646799)
  ui.destructive: color = ui.palette-destructive
  ui.palette-tab-active: color = light-dark(#ffffff, rgb(255 255 255 / 4.5%))
    when ui-preset=rose: light-dark(#fffdfd, #4a2434)
    when ui-preset=amber: light-dark(#fffef9, #4c3519)
    when ui-preset=violet: light-dark(#fefaff, #40205a)
  ui.tab-active: color = ui.palette-tab-active
  ui.palette-tab-active-border: color = light-dark(transparent, #ffffff26)
    when ui-preset=rose: light-dark(transparent, #683448)
    when ui-preset=amber: light-dark(transparent, #6b4c26)
    when ui-preset=violet: light-dark(transparent, #583570)
  ui.tab-active-border: color = ui.palette-tab-active-border
  ui.palette-shadow-sm: color = #0000001a scheme=fixed
  ui.shadow-sm: color = ui.palette-shadow-sm
  ui.palette-primary-hover: color = light-dark(#000000e6, #e5e5e5e6)
  ui.primary-hover: color = color-mix(in srgb, ui.primary 90%, transparent)
  ui.palette-secondary-hover: color = light-dark(#f5f5f5cc, #262626cc)
  ui.secondary-hover: color = color-mix(in srgb, ui.muted 80%, transparent)
  ui.palette-outline: color = light-dark(#ffffff, #ffffff0b)
    when ui-preset=rose: light-dark(#fffdfd, #29131c)
    when ui-preset=amber: light-dark(#fffef9, #2b1d0e)
    when ui-preset=violet: light-dark(#fefaff, #21112f)
  ui.outline: color = ui.palette-outline
  ui.palette-outline-hover: color = light-dark(#f5f5f5, #ffffff13)
    when ui-preset=rose: light-dark(#fce7ef, #3c1c2b)
    when ui-preset=amber: light-dark(#f9ecd0, #3c2a13)
    when ui-preset=violet: light-dark(#f3e8ff, #301647)
  ui.outline-hover: color = light-dark(ui.muted, ui.palette-outline-hover)
  ui.palette-ghost-hover: color = light-dark(#f5f5f5, #26262680)
  ui.ghost-hover: color = light-dark(ui.muted, color-mix(in srgb, ui.muted 50.19607843137255%, transparent))
  ui.palette-destructive-hover: color = light-dark(#e7000be6, #ff64678a)
  ui.destructive-hover: color = color-mix(in srgb, ui.destructive 90%, transparent)
  ui.palette-tab-inactive: color = light-dark(#00000099, #a1a1a1)
    when ui-preset=rose: light-dark(#875064, #d9a5b7)
    when ui-preset=amber: light-dark(#79603a, #d4ba8e)
    when ui-preset=violet: light-dark(#6b21a8, #d8b4fe)
  ui.tab-inactive: color = ui.palette-tab-inactive
  ui.palette-chart-grid: color = light-dark(#e5e5e580, #ffffff0d)
  ui.chart-grid: color = color-mix(in srgb, ui.border 50%, transparent)
  ui.palette-tab-count: color = light-dark(#7373734d, #a1a1a14d)
  ui.tab-count: color = color-mix(in srgb, ui.muted-foreground 30%, transparent)
  ui.palette-sidebar-label: color = light-dark(#000000b3, #fafafab3)
  ui.sidebar-label: color = color-mix(in srgb, ui.foreground 70%, transparent)
  ui.palette-trace-shimmer: color = light-dark(#d4d4d4, #fafafa)
