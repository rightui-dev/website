test "card validates locally rejects malformed email and resets"
  at "/docs/components/card"
  clock data
  tap "composition-save"
  expect text "composition-name-error-message-0" == "Enter your name."
  expect text "composition-email-error-message-0" == "Enter a valid email address."
  type "composition-name" "Ada"
  type "composition-email" "ada@@example.com"
  tap "composition-save"
  expect text "composition-result" == "No information sent."
  expect tree has "composition-email-error-message-0"
  type "composition-email" "ada@example.com"
  type "composition-email" key "Enter"
  expect text "composition-result" == "Profile validated locally."
  expect tree missing "composition-email-error-message-0"
  tap "composition-disable"
  expect disabled "composition-name"
  expect disabled "composition-email"
  expect disabled "composition-save"
  tap "composition-disable"
  tap "composition-reset"
  expect text "composition-name" == ""
  expect text "composition-result" == "No information sent."
  tap "card-login-submit"
  expect tree has "card-login-email-error-message-0"
  type "card-login-email" "ada@example.com"
  type "card-login-password" "example-password"
  tap "card-login-submit"
  expect text "card-login-result" == "Credentials validated locally. No sign-in request sent."
  tap "card-image-default-view"
  expect tree has "card-image-default-event"
  expect no failures
  screenshot "/tmp/rightui-review-card.png"

