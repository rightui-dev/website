test "attachment preview closes retries recovered content and removes independently"
  at "/docs/components/attachment"
  size 390x844
  prefer prefers-reduced-motion reduce
  clock data
  tap "content-attachment-preview"
  clock settle
  expect text "content-attachment-content" == "RightUI component review\nCheck keyboard navigation, responsive layouts and shared themes.\nDeliver a reusable Exact interface."
  type "content-attachment-dialog-body" key "Escape"
  clock settle
  expect tree missing "content-attachment-content"
  expect disabled "attachment-error-preview"
  tap "attachment-error-retry"
  expect tree missing "attachment-error-retry"
  expect enabled "attachment-error-preview"
  tap "attachment-error-preview"
  clock settle
  expect text "attachment-error-dialog-content" == "component,status\nButton,ready\nCard,ready\nCheckbox,ready"
  tap "attachment-error-dialog-close"
  clock settle
  expect tree missing "attachment-error-dialog-content"
  tap "content-attachment-remove"
  expect tree missing "content-attachment"
  expect tree has "attachment-error"
  tap "attachment-uploading-remove"
  expect tree missing "attachment-uploading"
  tap "attachment-restore"
  expect tree has "content-attachment"
  expect tree has "attachment-uploading"
  expect no failures

