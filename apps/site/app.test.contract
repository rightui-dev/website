test "appearance survives component Back Forward and reload"
  at "/docs/components/switch?theme=light&preset=neutral&density=compact&radius=default&font=sans&example=retained#top"
  size 1280x900
  clock data
  clock +1
  tap "theme-toggle"
  tap "quick-scheme-1"
  tap "quick-palette-5"
  tap "quick-font-1"
  tap "quick-radius-2"
  type "quick-radius-2" key "Escape"
  tap "docs-link-tabs"
  clock data
  tap "theme-toggle"
  tap "quick-scheme-2"
  tap "quick-palette-4"
  tap "quick-font-2"
  tap "quick-radius-1"
  type "quick-radius-1" key "Escape"
  expect state scheme == "system"
  expect state preset == "amber"
  expect state density == "compact"
  expect state radius == "sharp"
  expect state fontChoice == "mono"
  tap "site-shell" history -1
  clock data
  clock +1
  expect text "page-title" == "Switch"
  expect state scheme == "system"
  expect state preset == "amber"
  expect state density == "compact"
  expect state radius == "sharp"
  expect state fontChoice == "mono"
  expect state themeQuery == "system"
  expect state presetQuery == "amber"
  expect state currentAppearanceURL == "/docs/components/switch?theme=system&preset=amber&density=compact&radius=sharp&font=mono&example=retained#top"
  tap "site-shell" history 1
  clock data
  clock +1
  expect text "page-title" == "Tabs"
  expect state preset == "amber"
  tap "site-shell" history -1
  clock data
  clock +1
  reload
  clock +1
  expect text "page-title" == "Switch"
  expect state scheme == "system"
  expect state preset == "amber"
  expect state density == "compact"
  expect state radius == "sharp"
  expect state fontChoice == "mono"
  tap "site-shell" history 1
  clock data
  clock +1
  expect text "page-title" == "Tabs"
  expect state preset == "amber"
  expect state fontChoice == "mono"
  expect no failures

