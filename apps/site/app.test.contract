test "chart tooltip totals track visible series and preserve raw area values"
  at "/docs/components/chart"
  size 1280x1000
  clock data
  tap "data-chart-point-1"
  expect text "data-chart-value-desktop" == "305"
  expect text "data-chart-value-mobile" == "200"
  expect text "data-chart-total" == "505"
  tap "data-chart-legend-mobile"
  tap "data-chart-point-1"
  expect tree missing "data-chart-value-mobile"
  expect text "data-chart-total" == "305"
  tap "data-chart-legend-desktop"
  expect text "data-chart-empty" == "All series are hidden. Use the legend to show a series."
  tap "data-chart-legend-desktop"
  tap "data-chart-point-1"
  expect text "data-chart-total" == "305"
  type "parity-line" key "Home"
  type "parity-line" key "ArrowRight"
  expect text "parity-line-value-desktop" == "305"
  expect text "parity-line-total" == "505"
  type "area-chart" key "Home"
  type "area-chart" key "ArrowRight"
  expect text "area-chart-value-desktop" == "380"
  expect text "area-chart-value-mobile" == "420"
  expect text "area-chart-total" == "800"
  expect no failures

