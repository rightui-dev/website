test "component installation switches package manager and source method"
  at "/docs/components/button"
  size 1280x1000
  clock data
  clock settle
  expect tree has "github-link"
  expect text "install-button-command" == "bun add --exact @rightui/ui@0.3.0-beta.6"
  tap "install-button-copy"
  expect text "install-button-copy" == "Copied"
  clock +2999
  expect text "install-button-copy" == "Copied"
  clock +1
  expect text "install-button-copy" == "Copy"
  tap "install-button-manager-1"
  expect text "install-button-command" == "npm install --save-exact @rightui/ui@0.3.0-beta.6"
  tap "install-button-mode-1"
  expect text "install-button-command-line-0" == "mkdir -p vendor/rightui vendor/rightui-ui"
  expect text "install-button-command-line-1" == "npm pack @rightui/ui@0.3.0-beta.6 --pack-destination vendor/rightui"
  expect text "install-button-command-line-2" == "tar -xzf ./vendor/rightui/rightui-ui-0.3.0-beta.6.tgz -C vendor/rightui-ui --strip-components=1"
  expect text "install-button-command-line-3" == "npm install file:./vendor/rightui-ui"
  expect tree has "install-button-expand"
  tap "install-button-expand"
  expect text "install-button-expand" == "Collapse source"
  tap "install-button-manager-0"
  tap "install-button-mode-0"
  expect text "install-button-command" == "bun add --exact @rightui/ui@0.3.0-beta.6"
  expect no failures

