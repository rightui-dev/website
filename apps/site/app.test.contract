test "component pager follows catalog order and preserves appearance"
  at "/docs/components/checkbox?theme=dark&preset=rose&density=comfortable&radius=rounded&font=serif"
  size 390x844
  clock data
  clock settle
  tap "component-next"
  clock data
  clock settle
  expect text "page-title" == "Code Block"
  expect state scheme == "dark"
  expect state preset == "rose"
  expect state fontChoice == "serif"
  tap "component-previous"
  clock data
  clock settle
  expect text "page-title" == "Checkbox"
  tap "component-previous"
  clock data
  clock settle
  expect text "page-title" == "Chart"
  expect state scheme == "dark"
  expect state preset == "rose"
  expect no failures

