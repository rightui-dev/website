use CodeBlockAdvanced from "@rightui/ui"

// Documentation supplies source identity; rendering and actions belong to the package.
component Code
  props
    id: string
    code: string
    title: string
    language: string
    compact: bool
  view
    CodeBlockAdvanced(id=id, title=title, language=language, code=code, lines=[], numbers=false, startLine=1, showDownload=true, maxHeight=(compact ? 288 : 576), compact=compact, variant="default")
