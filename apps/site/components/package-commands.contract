use uiFontFamily from "@rightui/ui"
use TabsAdvanced, ButtonContent, CodeBlockSurface, CodeBlockHeader, CodeBlockBody from "@rightui/ui"

component PackageCommands
  props
    id: string
    commands: string[]
    reduced: bool
  state selected = 0
  inject
    uiCopiedId: string
    uiCopiedText: string
    uiCopyCode: action
  derive copied = uiCopiedId == id and uiCopiedText == command
  derive command = match commands.at(selected) { case some(value) => value, case none => "" }
  action choose(value: number)
    selected = value
  action copy
    uiCopyCode(id, command)
  view
    CommandPanel(id=id, command=command, selected=selected, copied=copied, reduced=reduced, choose=choose, copy=copy)

component CommandPanel
  props
    id: string
    command: string
    selected: number
    copied: bool
    reduced: bool
    choose: action
    copy: action
  inject
    uiFont: string
  view
    CodeBlockSurface(id=id, compact=false, variant="default", ai=false)
      CodeBlockHeader(compact=false)
        TabsAdvanced(id=id + "-manager", label="Package manager", labels=["Bun", "npm", "pnpm", "Yarn"], counts=[], selected=selected, variant="default", vertical=false, compact=true, disabledIndices=[], direction="ltr", reduced=reduced, choose=choose)
        ButtonContent(id=id + "-copy", label="Copy installation command", variant="ghost", size="sm", disabled=false, press=copy)
          text (copied ? "Copied" : "Copy") font-family=uiFontFamily(uiFont) data-rightui-font="body"
      view id=(id + "-manager-panel") testId=(id + "-command") role="tabpanel" aria-labelledby=(id + "-manager-" + selected.toString()) min-width=0
        CodeBlockBody(id=id + "-command", heading="Installation command", code=command, lines=[], numbers=false, diff=false, startLine=1, maxHeight=256, compact=false, variant="default", wrapped=false)
