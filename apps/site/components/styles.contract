style Hit
  appearance="none"
  font-family="Geist"
  font-size="0.875rem"
  font-weight=500
  color="ui.foreground"
  background-color="transparent"
  border="0"
  border-radius="ui.radius-item"
  cursor="pointer"
  text-decoration="none"
  box-sizing="border-box"
  min-width=0
  :hover
    background-color="ui.muted"
  :focus-visible
    box-shadow="0 0 0 3px ui.ring"
style QuietLink
  color="ui.muted-foreground"
  text-decoration="none"
  font-size="0.8125rem"
  line-height=1.5
  :hover
    color="ui.foreground"
  :focus-visible
    box-shadow="0 0 0 3px ui.ring"
style Heading
  min-width=0
  max-width="100%"
  hyphens="auto"
  font-size="1.875rem"
  font-weight=600
  letter-spacing="-0.025em"
  line-height=1.2
  margin=0
style Paragraph
  min-width=0
  max-width="100%"
  hyphens="auto"
  font-size="0.9375rem"
  line-height=1.75
  margin=0
  color="ui.foreground"
