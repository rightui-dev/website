use FontWeights from "@rightui/ui"
use uiFontFamily from "@rightui/ui"
use Hit from "./styles.contract"
use AppDropMark, ArrowRight from "./try-app.contract"
component Hero
  props
    width: number
    title: string
    secondLine: string
    description: string
    primary: string
    primaryHref: string
    secondary: string
    secondaryHref: string
  inject
    uiWeights: FontWeights
    uiFont: string
  view
    section id="page-hero" padding="calc(ui.space-64 + clamp(0px, (100vw - 767px) * 1000, ui.space-80)) calc(ui.space-20 + clamp(0px, (100vw - 767px) * 1000, ui.space-4)) ui.space-48" align-items="center" display="flex" flex-direction="column" gap="ui.space-16" text-align="center"
      link href="/try" testId="try-appdrop" class=Hit font-weight=uiWeights.medium padding="ui.space-6 ui.space-12" border-radius="ui.radius-full" background-color="ui.muted" display="flex" align-items="center" gap="ui.space-8"
        AppDropMark()
        text "Essayer avec AppDrop" font-size="ui.text-xs" line-height="ui.leading-normal" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        ArrowRight()
      h1 id="hero-title" data-rightui-font-scope=(secondLine != "" ? "home-title" : "page-title") min-width=0 max-width="min(72rem, 100%)" hyphens="none" margin="ui.space-0" display="flex" flex-direction="column" align-items="center" font-size=(width >= 1200 ? 72 : width >= 768 ? 56 : secondLine != "" ? min(40, max(20, (width - 40) / 12)) : 40) font-weight=uiWeights.semibold letter-spacing="ui.tracking-hero" line-height="ui.leading-display"
        text title white-space=(secondLine != "" ? "nowrap" : "normal") font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if secondLine != ""
          text secondLine white-space="nowrap" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text description id="hero-description" min-width=0 max-width="min(54rem, 100%)" hyphens="auto" margin="ui.space-0" font-size=(width >= 768 ? 22 : 18) line-height="ui.leading-hero" text-align="center" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row gap="ui.space-10" padding-top="ui.space-10" justify-content="center"
        link href=primaryHref testId="hero-primary" class=Hit font-weight=uiWeights.medium padding="ui.space-7 ui.space-13" border-radius="ui.radius-full" background-color="ui.primary" color="ui.primary-foreground" transition="background-color ui.duration-fast ui.easing"
          :hover
            background-color="ui.primary-hover"
            color="ui.primary-foreground"
          :active
            background-color="ui.primary-hover"
            color="ui.primary-foreground"
          text primary line-height="ui.leading-snug" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        link href=secondaryHref class=Hit font-weight=uiWeights.medium padding="ui.space-7 ui.space-13" border-radius="ui.radius-full" background-color="ui.muted"
          text secondary line-height="ui.leading-snug" font-family=uiFontFamily(uiFont) data-rightui-font="body"
