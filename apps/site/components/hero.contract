use uiFontFamily from "@rightui/ui"
use Hit from "./styles.contract"
use AppDropMark, ArrowRight from "./try-app.contract"
component Hero
  props
    title: string
    description: string
    primary: string
    primaryHref: string
    secondary: string
    secondaryHref: string
  inject
    uiFont: string
  view
    section id="page-hero" padding="calc(ui.space-64 + clamp(0px, (100vw - 767px) * 1000, ui.space-80)) calc(ui.space-20 + clamp(0px, (100vw - 767px) * 1000, ui.space-4)) ui.space-48" align-items="center" display="flex" flex-direction="column" gap="ui.space-16" text-align="center"
      link href="/try" testId="try-appdrop" class=Hit padding="ui.space-6 ui.space-12" border-radius="ui.radius-full" background-color="ui.muted" display="flex" align-items="center" gap="ui.space-8"
        AppDropMark()
        text "Essayer avec AppDrop" font-size="ui.text-xs" line-height="ui.leading-normal" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        ArrowRight()
      h1 id="hero-title" min-width=0 max-width="min(64rem, 100%)" hyphens="auto" margin="ui.space-0" font-weight="ui.weight-semibold" letter-spacing="ui.tracking-hero" line-height="ui.leading-display"
        text title font-family=uiFontFamily(uiFont) data-rightui-font="body"
      text description id="hero-description" min-width=0 max-width="min(50rem, 100%)" hyphens="auto" margin="ui.space-0" line-height="ui.leading-hero" text-align="center" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      row gap="ui.space-10" padding-top="ui.space-10" justify-content="center"
        link href=primaryHref class=Hit padding="ui.space-7 ui.space-13" border-radius="ui.radius-full" background-color="ui.primary" color="ui.primary-foreground"
          text primary line-height="ui.leading-snug" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        link href=secondaryHref class=Hit padding="ui.space-7 ui.space-13" border-radius="ui.radius-full" background-color="ui.muted"
          text secondary line-height="ui.leading-snug" font-family=uiFontFamily(uiFont) data-rightui-font="body"
