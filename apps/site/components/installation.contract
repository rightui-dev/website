use uiFontFamily from "@rightui/ui"
use TabsAdvanced from "@rightui/ui"
use Code from "./code.contract"
use Hit from "./styles.contract"
use CommandPanel from "./package-commands.contract"

component Installation
  props
    id: string
    version: string
    sourcePath: string
    sourceCode: string
    importCode: string
    reduced: bool
  state mode = 0
  state manager = 0
  state expanded = false
  derive archive = "./vendor/rightui/rightui-ui-" + version + ".tgz"
  derive installer = manager == 0 ? "bun add " : manager == 1 ? "npm install " : manager == 2 ? "pnpm add " : "yarn add "
  derive exactFlag = manager == 0 or manager == 3 ? "--exact " : "--save-exact "
  derive command = mode == 0 ? installer + exactFlag + "@rightui/ui@" + version : "mkdir -p vendor/rightui vendor/rightui-ui\nnpm pack @rightui/ui@" + version + " --pack-destination vendor/rightui\ntar -xzf " + archive + " -C vendor/rightui-ui --strip-components=1\n" + installer + "file:./vendor/rightui-ui"
  action chooseMode(value: number)
    mode = value
  action chooseManager(value: number)
    manager = value
  action copy
    uiCopyCode(id, command)
  action toggleSource
    expanded = not expanded
  derive copied = uiCopiedId == id and uiCopiedText == command
  inject
    uiFont: string
    uiCopiedId: string
    uiCopiedText: string
    uiCopyCode: action
  view
    section id="installation" min-width=0 display="flex" flex-direction="column" gap="ui.space-16"
      h2 margin="ui.space-0" font-size="ui.text-xl" font-weight="ui.weight-semibold"
        text "Installation" font-family=uiFontFamily(uiFont) data-rightui-font="body"
      TabsAdvanced(id=id + "-mode", label="Installation method", labels=["Command", "Manual"], counts=[], selected=mode, variant="line", vertical=false, compact=true, disabledIndices=[], direction="ltr", reduced=reduced, choose=chooseMode)
      column id=(id + "-mode-panel") role="tabpanel" aria-labelledby=(id + "-mode-" + mode.toString()) gap="ui.space-16" min-width=0
        text "Install the shared package once in your Exact app. This version is a beta." font-size="ui.text-sm" color="ui.muted-foreground" line-height="ui.leading-copy" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        CommandPanel(id=id, command=command, selected=manager, copied=copied, reduced=reduced, choose=chooseManager, copy=copy)
        text "The Exact compiler requires Bun 1.4.2, regardless of which package manager installs the package." font-size="ui.text-sm" color="ui.muted-foreground" line-height="ui.leading-copy" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if mode == 1
          text "Download the source package from npm, then install your editable copy as a local dependency. Keep package.json, the Contract files, ui.tamber, assets and licenses together." font-size="ui.text-sm" color="ui.muted-foreground" line-height="ui.leading-copy" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          row align-items="center" justify-content="space-between" gap="ui.space-12"
            text "Component source" font-size="ui.text-sm" font-weight="ui.weight-medium" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            button class=Hit press=toggleSource aria-expanded=expanded testId=(id + "-expand") padding="ui.space-4 ui.space-8"
              text (expanded ? "Collapse source" : "Expand source") font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          Code(id=id + "-source-code", code=sourceCode, title=sourcePath, language="contract", compact=not expanded)
        link href="/docs/installation" font-size="ui.text-sm" color="ui.foreground"
          text "Complete the font, app metadata and root provider setup (required for both installation methods)." font-family=uiFontFamily(uiFont) data-rightui-font="body"
      Code(id=id + "-import-code", code=importCode, title="Import", language="contract", compact=true)
