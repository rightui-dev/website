use TabsAdvanced from "@rightui/ui"
use Code from "./code.contract"
use Hit from "./styles.contract"
use CommandPanel from "./package-commands.contract"

component Installation
  props
    id: string
    version: string
    sourcePath: string
    sourceCode: string
    importCode: string
    reduced: bool
  state mode = 0
  state manager = 0
  state copied = false
  state expanded = false
  derive archive = "./vendor/rightui/rightui-ui-" + version + ".tgz"
  derive installer = manager == 0 ? "bun add " : manager == 1 ? "npm install " : manager == 2 ? "pnpm add " : "yarn add "
  derive exactFlag = manager == 0 or manager == 3 ? "--exact " : "--save-exact "
  derive command = mode == 0 ? installer + exactFlag + "@rightui/ui@" + version : "mkdir -p vendor/rightui vendor/rightui-ui\nnpm pack @rightui/ui@" + version + " --pack-destination vendor/rightui\ntar -xzf " + archive + " -C vendor/rightui-ui --strip-components=1\n" + installer + "file:./vendor/rightui-ui"
  action chooseMode(value: number)
    mode = value
    copied = false
  action chooseManager(value: number)
    manager = value
    copied = false
  action copy
    copyText(command)
    copied = true
  action toggleSource
    expanded = not expanded
  view
    section id="installation" min-width=0 display="flex" flex-direction="column" gap=16
      h2 "Installation" margin=0 font-size="1.25rem" font-weight=600
      TabsAdvanced(id=id + "-mode", label="Installation method", labels=["Command", "Manual"], counts=[], selected=mode, variant="line", vertical=false, compact=true, disabledIndices=[], direction="ltr", reduced=reduced, choose=chooseMode)
      column id=(id + "-mode-panel") role="tabpanel" aria-labelledby=(id + "-mode-" + mode.toString()) gap=16 min-width=0
        text "Install the shared package once in your Exact app. This version is a beta." font-size="0.875rem" color="ui.muted-foreground" line-height=1.6
        CommandPanel(id=id, command=command, selected=manager, copied=copied, reduced=reduced, choose=chooseManager, copy=copy)
        text "The Exact compiler requires Bun 1.4.2, regardless of which package manager installs the package." font-size="0.875rem" color="ui.muted-foreground" line-height=1.6
        if mode == 1
          text "Download the source package from npm, then install your editable copy as a local dependency. Keep package.json, the Contract files, ui.tamber, assets and licenses together." font-size="0.875rem" color="ui.muted-foreground" line-height=1.6
          row align-items="center" justify-content="space-between" gap=12
            text "Component source" font-size="0.875rem" font-weight=500
            button class=Hit press=toggleSource aria-expanded=expanded testId=(id + "-expand") padding="4px 8px"
              text (expanded ? "Collapse source" : "Expand source") font-size="0.75rem"
          Code(code=sourceCode, title=sourcePath, language="contract", compact=not expanded)
        link href="/docs/installation#font" font-size="0.875rem" color="ui.foreground"
          text "Register Geist before using components (required for both installation methods)."
      Code(code=importCode, title="Import", language="contract", compact=true)
