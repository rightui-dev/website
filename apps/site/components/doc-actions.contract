use FontWeights from "@rightui/ui"
use uiFontFamily from "@rightui/ui"
use MenuEntry, ButtonSegment from "@rightui/ui"
use Hit from "./styles.contract"

component DocActions
  props
    title: string
    markdown: string
    markdownHref: string
  state groupFocused = false
  action focusGroup
    groupFocused = true
  action blurGroup(e: FocusEvent)
    match e.relatedTarget
      case some(target)
        groupFocused = target.startsWith(id)
      case none
        groupFocused = false
  derive copied = uiCopiedId == id and uiCopiedText == markdown
  state assistantCopied = false
  derive id = "doc-actions-" + encodeURIComponent(title)
  derive label = "Documentation actions"
  derive entries = [MenuEntry(id="markdown", label="View as Markdown", shortcut="", disabled=false, destructive=false), MenuEntry(id="https://chatgpt.com/", label="Open in ChatGPT", shortcut="", disabled=false, destructive=false), MenuEntry(id="https://claude.ai/", label="Open in Claude", shortcut="", disabled=false, destructive=false)]
  action copy
    uiCopyCode(id, markdown)
  state expanded = false
  state openEpoch = 0
  state contextFocus = false
  derive enabled = entries.filter(item => not item.disabled)
  action open
    contextFocus = false
    openEpoch = openEpoch + 1
    expanded = true
    showPopover(id + "-menu", source=id)
    match first(enabled)
      case some(item)
        focus(id + "-item-" + item.id)
      case none
        focus(id + "-menu")
  action closeMenu
    expanded = false
    focus(id)
  action toggle
    if expanded
      closeMenu()
    else
      open()
  action changed(epoch: number, e: ToggleEvent)
    if epoch == openEpoch
      expanded = e.newState == "open"
      if e.newState == "open" and contextFocus
        match first(enabled)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
      contextFocus = false

  action pick(item: MenuEntry)
    if not item.disabled and item.id != "markdown"
      closeMenu()
      uiCopyCode(id, markdown)
      assistantCopied = true
      openURL(item.id)
  action triggerKeys(k: string, e: KeyboardEvent)
    if k == "ArrowDown" or k == "ArrowUp" or k == "ContextMenu" or (k == "F10" and e.shiftKey)
      preventDefault()
      open()
      if k == "ArrowUp"
        match enabled.at(enabled.length - 1)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
  action menuKeys(k: string)
    if k == "Escape"
      preventDefault()
      stopPropagation()
      closeMenu()
    else if k == "Tab"
      closeMenu()
  action itemKeys(itemId: string, k: string, e: KeyboardEvent)
    if not e.isComposing
      let index = enabled.map(item => item.id).indexOf(itemId)
      if k == "ArrowDown" or k == "ArrowUp" or k == "Home" or k == "End"
        preventDefault()
        let next = (k == "Home" ? 0 : k == "End" ? enabled.length - 1 : (index + (k == "ArrowDown" ? 1 : enabled.length - 1)) % max(1, enabled.length))
        match enabled.at(next)
          case some(item)
            focus(id + "-item-" + item.id)
          case none
            focus(id + "-menu")
      else if (k == "Enter" or k == " ") and itemId != "markdown"
        preventDefault()
        match enabled.at(index)
          case some(item)
            pick(item)
          case none
            closeMenu()
      else if k.length == 1 and not e.metaKey and not e.ctrlKey and not e.altKey
        match first(enabled.filter(item => item.label.toLowerCase().startsWith(k.toLowerCase())))
          case some(item)
            preventDefault()
            focus(id + "-item-" + item.id)
          case none
            stopPropagation()
  inject
    uiWeights: FontWeights
    uiFont: string
    uiCopiedId: string
    uiCopiedText: string
    uiCopyCode: action
  view
    column min-width=0 align-items="flex-start"
      row gap="ui.space-0" align-items="center" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" overflow="hidden" focusin=focusGroup focusout=blurGroup box-shadow=(groupFocused ? "ui.shadow-focus" : "none")
        ButtonSegment(id=id + "-copy", label="Copy page", disabled=false, press=copy)
          svg width="ui.space-14" height="ui.space-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
            rect x=8 y=8 width=12 height=12 rx=2
            path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"
          text (copied ? "Copied" : "Copy Page") font-family=uiFontFamily(uiFont) data-rightui-font="body"
        button id=id testId=id class=Hit font-weight=uiWeights.medium press=toggle key=triggerKeys aria-label=("Actions for " + title) aria-haspopup="menu" aria-expanded=expanded aria-controls=(id + "-menu") width="ui.space-32" height="ui.space-32" display="flex" align-items="center" justify-content="center" border-left-width="ui.border-width" border-left-style="solid" border-left-color="ui.border" border-radius="ui.radius-flat"
          svg width="ui.space-14" height="ui.space-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
            path d="m6 9 6 6 6-6"
      if expanded
        for epoch in [openEpoch] key=epoch
          column id=(id + "-menu") testId=(id + "-menu") popover="auto" toggle=changed(epoch) keycapture=menuKeys
            role="menu" aria-label=label tabindex=-1
            left="auto" top="auto" position-area="bottom" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline"
            width="14rem" min-width=0 max-width="calc(100vw - ui.space-32)" max-height="min(28rem, 70vh)" overflow="auto" box-sizing="border-box"
            margin="ui.space-4" padding="ui.space-4" gap="ui.space-0" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-menu" background-color="ui.surface" box-shadow="ui.shadow-menu"
            column role="none" align-items="stretch" gap="ui.space-0" min-width=0
              for item in entries key=item.id
                if item.id == "markdown"
                  link id=(id + "-item-markdown") testId=(id + "-item-markdown") href=markdownHref target="_blank" rel="noopener" role="menuitem" tabindex=-1 key=itemKeys(item.id) class=Hit display="flex" align-items="center" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" font-weight=uiWeights.regular
                    svg width="ui.space-14" height="ui.space-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
                      path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6"
                    text item.label font-family=uiFontFamily(uiFont) data-rightui-font="body"
                else
                  button id=(id + "-item-" + item.id) testId=(id + "-item-" + item.id) class=Hit
                    role="menuitem" tabindex=-1 disabled=item.disabled press=pick(item) key=itemKeys(item.id)
                    display="flex" width="100%" box-sizing="border-box" align-items="center" flex-wrap="wrap" gap="ui.space-8" min-height="ui.space-32" padding="ui.space-6 ui.space-8" border="0" border-radius="ui.radius-item" font-weight=uiWeights.regular background-color="transparent"
                    color=(item.destructive ? "ui.danger" : "ui.foreground")
                    :hover
                      background-color="ui.muted"
                    :focus-visible
                      background-color="ui.muted"
                    svg width="ui.space-14" height="ui.space-14" viewBox="0 0 128 128" aria-hidden=true
                      if item.id == "https://claude.ai/"
                        path fill="#D97757" d="m25.144 85.096 25.159-14.118.421-1.23-.421-.68h-1.23l-4.21-.26-14.377-.388-12.466-.518-12.078-.648-3.044-.648-2.85-3.755.292-1.879 2.558-1.716 3.659.324 8.095.55 12.143.842 8.807.519 13.05 1.36h2.072l.292-.842-.713-.518-.55-.519-12.564-8.516-13.6-9.002-7.123-5.18-3.853-2.623-1.943-2.461-.842-5.375 3.497-3.853 4.695.323 1.198.324 4.76 3.659 10.168 7.869 13.276 9.779 1.943 1.619.777-.55.097-.39-.875-1.457-7.22-13.049-7.707-13.276-3.432-5.504-.907-3.304c-.323-1.36-.55-2.492-.55-3.885L33.53.712 35.73 0l5.311.713 2.235 1.942 3.302 7.545 5.343 11.884 8.29 16.158 2.428 4.792 1.295 4.436.486 1.36h.842v-.777l.68-9.099 1.263-11.172 1.23-14.377.421-4.047L70.864 4.5l3.983-2.623 3.109 1.49 2.558 3.658-.356 2.364-1.522 9.876-2.979 15.478-1.943 10.362h1.133l1.296-1.295 5.245-6.962 8.808-11.01 3.886-4.37 4.533-4.825 2.914-2.3h5.505l4.047 6.023-1.813 6.218-5.666 7.188-4.696 6.087-6.735 9.067-4.21 7.253.39.583 1.003-.097 15.219-3.238 8.224-1.49 9.811-1.683 4.437 2.072.485 2.105-1.748 4.306-10.491 2.59-12.305 2.461-18.328 4.34-.226.162.259.323 8.257.778 3.53.194h8.645l16.093 1.198 4.21 2.784 2.525 3.4-.421 2.59-6.476 3.304-8.743-2.073-20.4-4.857-6.993-1.749h-.972v.583l5.829 5.7 10.685 9.649 13.373 12.434.68 3.076-1.716 2.429-1.813-.26-11.754-8.84-4.534-3.982-10.264-8.646h-.68v.907l2.364 3.465 12.499 18.78.647 5.764-.906 1.878-3.238 1.133-3.562-.647-7.318-10.265-7.545-11.56-6.087-10.361-.745.421-3.595 38.694-1.683 1.975-3.886 1.49-3.238-2.46-1.716-3.984 1.716-7.868 2.072-10.265 1.684-8.16 1.522-10.135.906-3.368-.064-.226-.745.097-7.642 10.492-11.624 15.704-9.197 9.843-2.201.875-3.82-1.976.355-3.53 2.137-3.14 12.726-16.19 7.674-10.038 4.954-5.796-.033-.842h-.29L22.066 98.987l-6.023.777-2.59-2.429.324-3.982 1.23-1.296 10.168-6.994Z"
                      else
                        path fill="#5061F7" d="M43.125 2.437a32.56 32.56 0 0 1 16.245-2.213c7.109 .816 13.445 3.84 19.008 9.067a.624 .624 0 0 0 .571 .155c7.509-1.845 14.731-1.195 21.659 1.952l.336 .16 .821 .405c7.237 3.749 12.427 9.44 15.563 17.056 1.483 3.621 2.229 7.403 2.245 11.339a30.16 30.16 0 0 1-.96 8.699 .891 .891 0 0 0 .213 .827 31.904 31.904 0 0 1 8.416 15.419c2.053 10.139-.053 19.28-6.309 27.413l-.971 1.173a32.336 32.336 0 0 1-15.648 9.872 .864 .864 0 0 0-.576 .544c-1.36 3.925-2.725 7.275-5.264 10.624-6.395 8.437-15.797 13.131-26.389 13.072-8.443-.043-15.925-3.131-22.453-9.259a.773 .773 0 0 0-.747-.171c-2.763 .891-5.547 1.019-8.555 .987a31.595 31.595 0 0 1-13.84-3.317 32.309 32.309 0 0 1-11.445-9.499c-1.083-1.435-2.155-2.784-2.939-4.379a41.28 41.28 0 0 1-2.64-6.843 32.587 32.587 0 0 1-.091-16.341 .885 .885 0 0 0 .043-.395 .613 .613 0 0 0-.197-.341 31.776 31.776 0 0 1-7.36-11.744 27.712 27.712 0 0 1-1.776-8.475 36.88 36.88 0 0 1 1.003-11.371c2.4-7.915 6.981-14.123 13.744-18.629 1.504-1.003 2.933-1.781 4.277-2.336 1.525-.64 3.056-1.173 4.592-1.621a.688 .688 0 0 0 .464-.464A32.085 32.085 0 0 1 30.053 12.32C33.68 7.808 38.037 4.512 43.125 2.437zm-4.288 41.867a4.523 4.523 0 0 0-7.856 4.491l9.035 15.813-9.003 15.189a4.528 4.528 0 0 0 7.787 4.608l10.347-17.451a4.528 4.528 0 0 0 .037-4.555l-10.347-18.096zm29.045 33.28a4.528 4.528 0 0 0 0 9.04h25.856a4.528 4.528 0 0 0 0-9.045h-25.856z"
                    text item.label flex="1 1 6rem" min-width=0 text-align="left" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    if item.shortcut != ""
                      text item.shortcut min-width=0 hyphens="auto" font-size="ui.text-xs" letter-spacing="ui.tracking-wide" color="ui.muted-foreground" aria-hidden=true font-family=uiFontFamily(uiFont) data-rightui-font="body"

      if assistantCopied
        text "Documentation copied. Paste it into your assistant." role="status" font-size="ui.text-xs" color="ui.muted-foreground" max-width="18rem" font-family=uiFontFamily(uiFont) data-rightui-font="body"
