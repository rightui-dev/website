use uiFontFamily from "@rightui/ui"
use Button, ButtonContent, ButtonSegment, InputControl, TextareaControl, Badge, RadioControl, CheckboxControl, SwitchControl, Switch, ProgressTrack, InputStyle, FeatureCardStyle as MosaicCard, InsetCardStyle as MosaicMuted, Hit from "@rightui/ui"

component HomeCards
  props
    width: number
    nativeApp: bool
    reduced: bool
    openDialog: action
  state name = ""
  state message = ""
  state compact = true
  state fruit = "apple"
  state alerts = true
  derive quickItems = ["Mute conversation", "Mark as read", "Block user", "Delete conversation"]
  state tab = "Overview"
  state selected = "Analytics"
  state saved = 65
  state report = false
  state dismissed = false
  state goal = ""
  state amount = "$15,000"
  state date = "Dec 2025"
  state created = false
  state draft = ""
  state messages = ["Hey! How can I help you today?", "I'd like to explore the components."]
  action selectFruit(value: string)
    fruit = value
  action fruitKey(item: string, key: string)
    if key == " " or key == "Enter"
      preventDefault()
      selectFruit(item)
    else if key == "ArrowRight" or key == "ArrowDown" or key == "ArrowLeft" or key == "ArrowUp"
      preventDefault()
      let next = item == "apple" ? "banana" : "apple"
      selectFruit(next)
      focus("home-fruit-" + next)
    else if key == "Home" or key == "End"
      preventDefault()
      let next = key == "Home" ? "apple" : "banana"
      selectFruit(next)
      focus("home-fruit-" + next)
  action toggleAlerts(value: bool)
    alerts = value
  action toggleCompact(value: bool)
    compact = value
  action quickActions
    showPopover("home-actions-panel", source="home-actions")
    focus("home-action-0")
  action quickAction(value: string)
    selected = value
    hidePopover("home-actions-panel")
    focus("home-actions")
  action quickKeys(index: number, key: string)
    if key == "Escape"
      preventDefault()
      hidePopover("home-actions-panel")
      focus("home-actions")
    else if key == "ArrowDown" or key == "ArrowUp" or key == "Home" or key == "End"
      preventDefault()
      let next = key == "Home" ? 0 : key == "End" ? quickItems.length - 1 : (index + (key == "ArrowDown" ? 1 : quickItems.length - 1)) % quickItems.length
      focus("home-action-" + next.toString())
  action editName(v: string)
    name = v
  action editMessage(v: string)
    message = v
  action toggle(v: bool)
    compact = v
  action selectTab(v: string)
    tab = v
  action selectItem(v: string)
    selected = v
  action save
    saved = min(100, saved + 5)
  action showReport
    report = not report
  action dismiss
    dismissed = not dismissed
  action editGoal(v: string)
    goal = v
  action editAmount(v: string)
    amount = v
  action editDate(v: string)
    date = v
  action create
    created = true
  action cancel
    goal = ""
    created = false
  action editDraft(v: string)
    draft = v
  action sendMessage
    if draft.trim() != ""
      messages = messages.concat([draft])
      draft = ""
  // CSS sizes the columns before the viewport resource activates.
  inject
    uiFont: string
  view
    view padding="ui.space-24" background-color="ui.muted" color="ui.foreground"
      row id="home-mosaic" gap="ui.space-0" max-width=1900 margin="ui.space-0 auto" align-items="flex-start"
        column id="home-column-controls" flex="1 1 0%" gap="ui.space-24" min-width=0
          column class=MosaicCard min-height=318 gap="ui.space-24"
            row gap="ui.space-8" flex-wrap="wrap"
              ButtonContent(id="home-primary", label="Button", variant="primary", size="sm", disabled=false, press=openDialog)
                text "Button →" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              ButtonContent(id="home-secondary", label="Secondary", variant="secondary", size="sm", disabled=false, press=openDialog)
                text "Secondary" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              ButtonContent(id="home-outline", label="Outline", variant="outline", size="sm", disabled=false, press=openDialog)
                text "Outline" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column gap="ui.space-12"
              InputControl(id="home-name", label="Name", value=name, placeholder="Name", disabled=false, edit=editName)
              TextareaControl(error="", descriptionId="", id="home-message", label="Message", value=message, placeholder="Message", disabled=false, edit=editMessage)
            row gap="ui.space-8" align-items="center" flex-wrap="wrap"
              Badge(label="Badge", variant="primary")
              Badge(label="Secondary", variant="secondary")
              row gap="ui.space-8" margin-left="auto" align-items="center" role="radiogroup" aria-label="Fruit preference"
                for item in ["apple", "banana"] key=item
                  RadioControl(id="home-fruit-" + item, label=item, checked=(fruit == item), disabled=false, tabIndex=(fruit == item ? 0 : -1), press=selectFruit(item), keys=fruitKey(item))
              CheckboxControl(id="home-alerts", label="Enable email alerts", checked=alerts, disabled=false, change=toggleAlerts)
              SwitchControl(id="home-compact", label="Compact notifications", checked=compact, disabled=false, reduced=reduced, change=toggleCompact)
            row gap="ui.space-8" justify-content="space-between" flex-wrap="wrap"
              ButtonContent(id="home-dialog", label="Alert Dialog", variant="outline", size="sm", disabled=false, press=openDialog)
                text "Alert Dialog" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              row gap="ui.space-0" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-control" overflow="hidden"
                ButtonSegment(id="home-button-group", label="Button Group", disabled=false, press=openDialog)
                  text "Button Group" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                ButtonSegment(id="home-actions", label="Open quick actions", disabled=false, press=quickActions)
                  svg width="ui.space-16" height="ui.space-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="ui.icon-stroke" aria-hidden=true
                    path d="m6 9 6 6 6-6"
          view display="grid" grid-template-columns="repeat(2, minmax(0, 1fr))" gap="ui.space-16"
            for group in ["Planning", "Support", "Overview", "Account"] key=group
              column class=MosaicCard padding="ui.space-16" gap="ui.space-8"
                text group font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                for item in (group == "Planning" ? ["Documents", "Budget", "Reports", "Goals", "Calendar"] : group == "Support" ? ["Help Center", "Docs", "Contact Us", "Status", "Community"] : group == "Overview" ? ["Analytics", "Transactions", "Investments", "Accounts", "Spending"] : ["Profile", "Billing", "Notifications", "Security", "Appearance"]) key=item
                  button class=Hit press=selectItem(item) aria-current=(selected == item ? "true" : "false") padding="ui.space-7 ui.space-8" border="0" border-radius="ui.radius-md" text-align="left" background-color=(selected == item ? "ui.muted" : "transparent") color="ui.foreground"
                    text item font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
          column class=MosaicCard
            text "Savings Targets" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            text "Local demo milestones. Adjust the progress below." color="ui.muted-foreground" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            for target in ["Retirement", "Real Estate"] key=target
              column class=MosaicMuted
                text target font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text (target == "Retirement" ? "$420,000" : "$85,000") font-size="ui.text-3xl" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                ProgressTrack(id="home-progress-" + target, label=target, value=(target == "Retirement" ? saved : 32))
                text (target == "Retirement" ? `${saved}% achieved` : "32% achieved") font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            Button(id="home-save", label="Add demo savings", variant="outline", disabled=saved == 100, press=save)
        if not nativeApp or width >= 1024
          column id="home-column-activity" flex="1 1 0%" gap="ui.space-24" min-width=0 max-width="clamp(0px, (100vw - 1023px) * 1000, 100vw)" max-height="max(0px, (100vw - 1023px) * 1000000)" margin-left="clamp(0px, (100vw - 1023px) * 1000, ui.space-24)" overflow="hidden" inert=(width < 1024)
            column class=MosaicCard
              column gap="ui.space-8"
                text "Contribution History" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text "Last 6 months of activity" color="ui.muted-foreground" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              row height=200 gap="ui.space-12" align-items="flex-end" role="img" aria-label="Demo contributions: December 800, January 1100, February 900, March 1300, April 750"
                for month in ["Dec", "Jan", "Feb", "Mar", "Apr"] key=month
                  column flex=1 gap="ui.space-8" justify-content="flex-end"
                    view height=(month == "Dec" ? 120 : month == "Jan" ? 165 : month == "Feb" ? 135 : month == "Mar" ? 175 : 112) background-color=(month == "Dec" ? "ui.chart-1" : month == "Jan" ? "ui.chart-2" : month == "Feb" ? "ui.chart-3" : month == "Mar" ? "ui.chart-4" : "ui.chart-5") border-radius="ui.radius-md"
                    text month font-size="ui.text-xs" text-align="center" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              row gap="ui.space-12"
                column class=MosaicMuted flex=1
                  text "UPCOMING" font-size="ui.text-2xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "May 2024" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "Scheduled" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                column class=MosaicMuted flex=1
                  text "SAVINGS PLAN" font-size="ui.text-2xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "Accelerated" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "Recurring" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Button(id="home-report", label=(report ? "Close Report" : "View Full Report"), variant="primary", disabled=false, press=showReport)
              if report
                text "Demo total: $4,850 across five contributions." font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column class=MosaicCard
              text "Claimable Balance" font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "$1,211.29" font-size="ui.text-4xl" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "● Pending Setup · Demo" font-size="ui.text-xs" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              column class=MosaicMuted
                row justify-content="space-between" gap="ui.space-12"
                  text "Net Royalties" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "$1,248.75" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                row justify-content="space-between" gap="ui.space-12"
                  text "Processing Fee" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "−$37.46" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                row justify-content="space-between" gap="ui.space-12"
                  text "Total Ready to Claim" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                  text "$1,211.29 USD" font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Illustrative balance only. No bank connection or distribution." font-size="ui.text-caption" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column class=MosaicCard
              Button(id="home-dividends", label=(dismissed ? "Show Dividend Income" : "Q2 Dividend Income ×"), variant="ghost", disabled=false, press=dismiss)
              if not dismissed
                text "Quarterly demo payouts across sample holdings." font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                for holding in ["Vanguard · 450 Shares", "S&P 500 VOO · 112 Shares", "Apple AAPL · 85 Shares", "Realty Income · 320 Shares"] key=holding
                  row class=MosaicMuted justify-content="space-between"
                    text holding font-size="ui.text-caption" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                    svg width="ui.space-80" height="ui.space-28" viewBox="0 0 80 28" fill="none" aria-hidden=true
                      polyline points=(holding.startsWith("Vanguard") ? "0,22 9,17 18,19 28,12 36,16 47,9 57,12 66,5 80,2" : holding.startsWith("Apple") ? "0,16 9,20 18,12 28,16 36,8 47,11 57,4 66,8 80,2" : "0,23 9,21 18,14 28,18 36,12 47,15 57,7 66,10 80,4") stroke="ui.chart-1" stroke-width="ui.stroke-medium"
        if not nativeApp or width >= 1400
          column id="home-column-goals" flex="1 1 0%" gap="ui.space-24" min-width=0 max-width="clamp(0px, (100vw - 1399px) * 1000, 100vw)" max-height="max(0px, (100vw - 1399px) * 1000000)" margin-left="clamp(0px, (100vw - 1399px) * 1000, ui.space-24)" overflow="hidden" inert=(width < 1400)
            column class=MosaicCard
              text "Set a new milestone" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Define a demo target and pace your savings." font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Goal Name" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              InputControl(id="home-goal", label="Goal Name", value=goal, placeholder="e.g. New Car, Home Downpayment", disabled=false, edit=editGoal)
              text "Target Amount" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              InputControl(id="home-amount", label="Target Amount", value=amount, placeholder="", disabled=false, edit=editAmount)
              text "Target Date" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              InputControl(id="home-date", label="Target Date", value=date, placeholder="", disabled=false, edit=editDate)
              Button(id="home-create", label="Create Goal", variant="primary", disabled=goal.trim() == "", press=create)
              Button(id="home-cancel", label="Cancel", variant="outline", disabled=false, press=cancel)
              if created
                text `Demo goal created: ${goal} · ${amount} · ${date}` font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column class=MosaicCard
              text "Payout Threshold" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Demo settings" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Switch(id="home-payout", label="Automatic payouts", checked=compact, disabled=false, reduced=reduced, change=toggle)
            column class=MosaicCard
              text "Account Access" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Manage local demo preferences." color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Button(id="home-access", label="Manage access", variant="outline", disabled=false, press=openDialog)
        if not nativeApp or width >= 768
          column id="home-column-chat" flex="1 1 0%" gap="ui.space-24" min-width=0 max-width="clamp(0px, (100vw - 767px) * 1000, 100vw)" max-height="max(0px, (100vw - 767px) * 1000000)" margin-left="clamp(0px, (100vw - 767px) * 1000, ui.space-24)" overflow="hidden" inert=(width < 768)
            column class=MosaicCard align-items="center" min-height=350 padding="ui.space-44 ui.space-20 ui.space-20" text-align="center" gap="ui.space-24" aria-label="Demonstration QR code linking to Exact on GitHub"
              link href="https://github.com/expo/exact" aria-label="Open Exact on GitHub" display="flex" padding="ui.space-16" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-card" background-color="ui.media-paper" box-sizing="border-box"
                image "assets/home/exact-qr.svg" width=160 height=160 alt="QR code: https://github.com/expo/exact"
              column gap="ui.space-8"
                text "Explore Exact on your mobile device" font-weight="ui.weight-semibold" font-size="ui.text-base" font-family=uiFontFamily(uiFont) data-rightui-font="body"
                text "Explore Exact on GitHub by scanning this demo code." font-size="ui.text-sm" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
            column class=MosaicCard
              text "Chat" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              for entry in messages key=entry
                text entry padding="ui.space-12" border-radius="ui.radius-2xl" background-color="ui.muted" font-size="ui.text-sm" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              input id="home-draft" class=InputStyle value=draft input=editDraft submit=sendMessage placeholder="Type your message..." aria-label="Message"
              Button(id="home-send", label="Send message ↑", variant="primary", disabled=draft.trim() == "", press=sendMessage)
            column class=MosaicCard
              text "Home › Account › Payments" font-size="ui.text-caption" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              for payment in ["Change transfer limit", "Scheduled transfers", "Recurring card payments"] key=payment
                button class=Hit press=selectItem(payment) padding="ui.space-16" border="0" border-radius="ui.radius-card" background-color="ui.muted" color="ui.foreground" text-align="left"
                  text `${payment} →` font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text `Selected: ${selected}` font-size="ui.text-xs" color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        if not nativeApp or width >= 1900
          column id="home-column-settings" flex="1 1 0%" gap="ui.space-24" min-width=0 max-width="clamp(0px, (100vw - 1899px) * 1000, 100vw)" max-height="max(0px, (100vw - 1899px) * 1000000)" margin-left="clamp(0px, (100vw - 1899px) * 1000, ui.space-24)" overflow="hidden" inert=(width < 1900)
            column class=MosaicCard
              text "Distribute. Track. Grow." font-size="ui.text-2xl" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              text "Explore your local demo workspace." color="ui.muted-foreground" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Button(id="home-start", label="Get started", variant="primary", disabled=false, press=openDialog)
            column class=MosaicCard
              text "Notification Settings" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              Switch(id="home-notify", label="Email notifications", checked=compact, disabled=false, reduced=reduced, change=toggle)
            column class=MosaicCard
              text "Power Usage" font-weight="ui.weight-semibold" font-family=uiFontFamily(uiFont) data-rightui-font="body"
              svg width="100%" height=120 viewBox="0 0 280 120" role="img" aria-label="Demo power usage by day"
                for value, index in [30, 45, 75, 50, 100, 65, 88] key=index
                  rect x=(index * 40) y=(120 - value) width=28 height=value rx="ui.radius-sm" fill="ui.chart-1"
      column id="home-actions-panel" popover="auto" role="menu" aria-label="Quick actions" position="absolute" left="auto" top="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline" margin="ui.space-4" width="14rem" max-width="calc(100vw - ui.space-32)" padding="ui.space-4" border-width="ui.border-width" border-style="solid" border-color="ui.border" border-radius="ui.radius-lg" background-color="ui.surface" color="ui.foreground" box-shadow="ui.shadow-menu"
        text "Quick Actions" font-size="ui.text-xs" font-weight="ui.weight-medium" padding="ui.space-6 ui.space-8" font-family=uiFontFamily(uiFont) data-rightui-font="body"
        for item, index in quickItems key=item
          button class=Hit id=("home-action-" + index.toString()) role="menuitem" tabindex=-1 press=quickAction(item) key=quickKeys(index) border="0" background-color="transparent" color="ui.foreground" padding="ui.space-7 ui.space-8" text-align="left" border-radius="ui.radius-sm" font-size="ui.text-caption" cursor="pointer"
            :hover
              background-color="ui.muted"
            text item font-family=uiFontFamily(uiFont) data-rightui-font="body"
